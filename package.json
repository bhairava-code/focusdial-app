{
  "name": "focusdial",
  "productName": "FocusDial",
  "version": "1.0.0",
  "description": "Floating flip clock, Pomodoro timer and task list",
  "author": "Pronoy Kumar Das",
  "main": "app/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "lint": "eslint app build eslint.config.js",
    "dist:windows": "npm run lint && electron-builder --win nsis portable --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:installer": "python3 installer/build-installer.py",
    "dist:linux-host": "npm run lint && npm run dist:portable && npm run dist:installer"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "com.pronoy.focusdial",
    "productName": "FocusDial",
    "copyright": "© 2026 Pronoy Kumar Das",
    "files": [
      "app/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "./build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FocusDial",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "artifactName": "FocusDial-Setup-${version}.exe",
      "uninstallDisplayName": "FocusDial"
    },
    "portable": {
      "artifactName": "FocusDial-Portable-${version}.exe"
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "asar": true
  }
}